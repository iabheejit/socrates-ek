# Server Configuration
port=3000

# Airtable Configuration
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_airtable_personal_access_token_here
AIRTABLE_STUDENT_BASE_ID=your_student_base_id_here
AIRTABLE_COURSE_BASE_ID=your_course_base_id_here

# Legacy Airtable Variables (for backward compatibility)
personal_access_token=your_airtable_personal_access_token_here
course_base=your_course_base_id_here
studentBase=your_student_base_id_here
studentTable=Student

# WhatsApp (WATI) Configuration
URL=your_wati_domain_here
API=your_wati_api_key_here
WATI_URL_FOR_CERTIFICATE=your_wati_domain_here
WAIT_API=your_wati_api_key_here

# Azure LLM Configuration
AZURE_LLAMA_ENDPOINT=https://your-azure-endpoint.inference.ai.azure.com/v1/chat/completions
AZURE_LLAMA_API_KEY=your_azure_api_key_here

# Azure Storage Configuration
azurestring=your_azure_storage_connection_string_here
containername=your_blob_container_name_here

# Hugging Face Configuration
HF_TOKEN=your_huggingface_token_here

# TuneAI Configuration
TUNE_API_URL=https://proxy.tune.app/chat/completions
TUNE_API_KEY=sk-tune-your_api_key_here
TUNE_ORG_ID=your_organization_id_here
tuneapi=your_tune_endpoint_here
tuneapikey=your_tune_api_key_here

# Optional: Alfred Waitlist (if used)
alfred_waitlist_base=your_alfred_waitlist_base_id_here

# Environment
NODE_ENV=development
